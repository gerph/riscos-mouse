/***************************************************************************
 * Function:     Mod_Init
 * Description:  Initialise the module, setting up vectors, callbacks and
 *               any other parts of the system necessary for the module to
 *               function.
 * Parameters:   tail        = pointer to command line (control terminated)
 *               podule_base = address of podule module was started from, or
 *                             NULL if none
 *               pw          = private word for module
 * On exit:      Return NULL for successful initialisation, or a pointer to
 *               an error block if the module could not start properly.
 **************************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    _kernel_oserror *err;
    int mouse_type;

    (void) tail;
    (void) podule_base;
    if (!mouse_hardware_supported()) {
        static _kernel_oserror error_bad_hardware = {
            ErrorNumber_BadHard, "Unsupported hardware configuration"
        };
        return &error_bad_hardware;
    }

    mouse_initialise();
    err = _swix(OS_Claim, _INR(0,2), PointerV, PointerV_Entry, pw);
    if (err != NULL) {
        mouse_finalise();
        return err;
    }

    err = _swix(OS_Pointer, _IN(0) | _OUT(0),
                OSPointer_ReadMouseType, &mouse_type);
    if (err != NULL) {
        _swix(OS_Release, _INR(0,2), PointerV, PointerV_Entry, pw);
        mouse_finalise();
        return err;
    }

    if (mouse_type == PointerDevice_QuadMouse)
        mouse_initialise();
    dprintf("Module Mouse2 initialised\n");
    return NULL;
}


/***************************************************************************
 * Function:     Mod_Final
 * Description:  Finalise the module, shutting down any systems necessary,
 *               freeing vectors and releasing workspace
 * Parameters:   fatal       = fatality indicator; 1 if fatal, 0 if
 *                             reinitialising
 *               podule_base = address of podule module was started from, or
 *                             NULL if none
 *               pw          = private word for module
 * On exit:      Return 0 for successful finalisation, or a pointer to an
 *               error block if module was not shutdown properly.
 **************************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    _kernel_oserror *err;

    (void) fatal;
    (void) podule_base;
    err = _swix(OS_Release, _INR(0,2), PointerV, PointerV_Entry, pw);
    mouse_finalise();
    dprintf("Module Mouse2 dying\n");
    return err;
}

/*******************************************************************
 Function:      Mod_Service
 Description:   Reinitialise the hardware after a system reset.
 Parameters:    service = service number
                r = service register block
                pw = module private word
 Returns:       none
 ******************************************************************/
void Mod_Service(int service, _kernel_swi_regs *r, void *pw)
{
    (void) r;
    (void) pw;
    if (service == Service_Reset)
        mouse_initialise();
}
